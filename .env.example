# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=megadent_pos
DB_PORT=3306

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h

# Admin Default Credentials (for initial setup)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# Telegram (backup + admin notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: separate chat for sale / debt notifications (defaults to TELEGRAM_CHAT_ID)
TELEGRAM_ADMIN_CHAT_ID=
# Optional: when to send the daily due-debts list (default: every day at 09:00, Asia/Tashkent)
TELEGRAM_DEBT_CRON=0 9 * * *
# Optional: set to false to stop the bot from listening to commands (/qarzlar, /yaqin, /oy)
TELEGRAM_BOT_POLLING=true

# Debt Markup Configuration
DEBT_CRON_SCHEDULE=0 0 1 * *
